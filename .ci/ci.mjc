version: 1
recipe: service
preset: node

delivery:
  mode: staged
  pr:
    deployToStg: false

build:
  pnpm:
    nodeVersion: 20.19.2
    packageName: "@services/svc-auth"
    steps:
      - type: lint
        name: Lint service sources
      - type: typecheck
        name: Typecheck service package
      - type: test
        name: Run unit tests
        command: test:unit
      - type: test
        name: Run integration tests
        command: test:integration
      - type: build
        name: Build service package

image:
  repository: registry.leultewolde.com/mereb/svc-auth
  context: .
  dockerfile: Dockerfile
  tagStrategy: branch-sha
  verifyPull: true
  push:
    enabled: true
    when: '!pr'
    credentialsId: docker-registry-local
    registry: registry.leultewolde.com

deploy:
  order:
    - dev
    - stg
    - prd

  dev:
    release: svc-auth-dev
    namespace: apps-dev
    chart: app-chart
    repo: https://charts.leultewolde.com
    repoCredentialId: helm-chart-creds
    valuesFiles:
      - .ci/values-dev.yaml
    generatedBaseValues:
      profile: apiService
      inputs:
        serviceName: svc-auth
        containerPort: 4010
        routePrefix: /auth
        configMapName: svc-auth-dev-config
        secretName: svc-auth-dev-secrets
        tlsSecretName: auth-dev-tls
        secretTemplates:
          DATABASE_URL: DATABASE_URL
          SPLUNK_HEC_TOKEN: SPLUNK_HEC_TOKEN
        extraEnv:
          - name: OIDC_ISSUER
            fromPlatformIdentityConfigKey: OIDC_ISSUER
          - name: OIDC_AUDIENCE
            fromPlatformIdentityConfigKey: ENV_API_AUDIENCE
    smoke:
      url: https://api-dev.mereb.app/auth/healthz
      retries: 3
      delay: 10
      timeout: 60s

  stg:
    release: svc-auth-stg
    namespace: apps-stg
    chart: app-chart
    repo: https://charts.leultewolde.com
    repoCredentialId: helm-chart-creds
    valuesFiles:
      - .ci/values-stg.yaml
    generatedBaseValues:
      profile: apiService
      inputs:
        serviceName: svc-auth
        containerPort: 4010
        routePrefix: /auth
        configMapName: svc-auth-stg-config
        secretName: svc-auth-stg-secrets
        tlsSecretName: auth-stg-tls
        secretTemplates:
          DATABASE_URL: DATABASE_URL
          SPLUNK_HEC_TOKEN: SPLUNK_HEC_TOKEN
        extraEnv:
          - name: OIDC_ISSUER
            fromPlatformIdentityConfigKey: OIDC_ISSUER
          - name: OIDC_AUDIENCE
            fromPlatformIdentityConfigKey: ENV_API_AUDIENCE
    smoke:
      url: https://api-stg.mereb.app/auth/healthz
      retries: 3
      delay: 10
      timeout: 60s

  prd:
    release: svc-auth
    namespace: apps-prd
    chart: app-chart
    repo: https://charts.leultewolde.com
    repoCredentialId: helm-chart-creds
    valuesFiles:
      - .ci/values-prd.yaml
    generatedBaseValues:
      profile: apiService
      inputs:
        serviceName: svc-auth
        containerPort: 4010
        routePrefix: /auth
        configMapName: svc-auth-prd-config
        secretName: svc-auth-prd-secrets
        tlsSecretName: auth-prd-tls
        secretTemplates:
          DATABASE_URL: DATABASE_URL
          SPLUNK_HEC_TOKEN: SPLUNK_HEC_TOKEN
        extraEnv:
          - name: OIDC_ISSUER
            fromPlatformIdentityConfigKey: OIDC_ISSUER
          - name: OIDC_AUDIENCE
            fromPlatformIdentityConfigKey: ENV_API_AUDIENCE
    smoke:
      url: https://api.mereb.app/auth/healthz
      retries: 3
      delay: 10
      timeout: 60s

signing:
  enabled: false

release:
  autoTag:
    enabled: true
    when: branch=main & !pr
    prefix: v
    bump: patch
    remote: origin
    gitUser: Mereb CI
    gitEmail: ci@mereb.dev
    credentialId: github-credentials
    clean: false
    allowDirty: true
    skipIfTagged: true
  github:
    enabled: true
    when: tag=^v[0-9].*
    repo: leultewolde/mereb-svc-auth
    stageName: GitHub Release
    credentialId: github-credentials
    generateReleaseNotes: true
